# Local uniquement : copier ce fichier en .env et remplacer les champs vides.
# Ne jamais committer .env. Sur Render : Environment Variables.
ENV=development
ADMIN_TOKEN=
WEBHOOK_SECRET=
# Local : SQLite. Production : postgresql://... ou postgresql+psycopg://...
DATABASE_URL=sqlite:///./maison-ia.db
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
# Pour Claude : LLM_PROVIDER=anthropic, LLM_MODEL=<modèle autorisé>, ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
MAX_JOBS_PER_DAY=10
WORKER_ENABLED=true
DAILY_BRIEFING_ENABLED=false
DAILY_BRIEFING_HOUR=8
# Stripe : clé restreinte en lecture seule (Checkout Sessions / Balance Transactions).
STRIPE_RESTRICTED_KEY=
# Compte de service Google partagé en lecture dans GA4 + Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GA4_PROPERTY_ID=543728215
SEARCH_CONSOLE_SITE_URL=https://lamaisondesdessous.fr/
# GitHub : token limité à philippe1720/lamaisondesdessous, Contents + Pull requests RW.
GITHUB_TOKEN=
GITHUB_SEO_ENABLED=false
# Email propriétaire uniquement. Resend HTTPS recommandé sur Render.
NOTIFY_OWNER=false
RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
# Boîte achats professionnelle uniquement : ne pas configurer la boîte personnelle.
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0
INSTAGRAM_PUBLISH_ENABLED=false
